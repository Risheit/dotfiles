{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama-server (local)",
      "options": {
        "baseURL": "http://127.0.0.1:9999/v1",
      },
      "models": {
        "unsloth/Qwen3.5-9B-GGUF:Q6_K": {
          "name": "Qwen3.5: 9B (local)",
          "limit": {
            "context": 60000,
            "output": 8000,
          },
          "reasoning": true,
          "options": {
            "chat_template_kwargs": {
              "enable_thinking": false,
            },
          },
          "interleaved": {
            "field": "reasoning_content",
          },
        },
      },
    },
  },
  "mcp": {
    "Git": {
      "type": "local",
      "command": [
        "sh",
        "-c",
        "exec mcp-server-git --repository \"$(git rev-parse --show-toplevel 2>/dev/null || echo .)\"",
      ],
    },
  },
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
    },
    "bash": {
      "*": "ask",
      "grep *": "allow",
      "cat *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "echo *": "allow",
      "date *": "allow",
      "whoami": "allow",
      "env": "allow",
      "find *": "allow",
    },
  },
  "agent": {
    "title": {
      "options": {
        "temperature": 0.5,
      },
    },
  },
}
